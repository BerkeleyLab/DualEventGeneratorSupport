# This setpoint is assumed to contain the event delay, which is then
# subtracted below
#
record(longout, $(T)TimInjFieldSyncDelaySP) {
	field(DESC, "Inj Field Delay SP in 4 * BROC")
	field(DTYP, "Soft Channel")
	field(FLNK, "$(T)GaussClockInjectionFieldTrigger PP")
	field(EGU, "4*BROC")
}

record(longout, "$(T)TimInjFieldEventDelay") {
	field(DESC, "Fine adjustment to Sync Delay")
	field(DTYP, "Soft Channel")
	field(FLNK, "$(T)GaussClockInjectionFieldTrigger PP")
	field(EGU, "EvtClkTicks")
}

record(calc, "$(T)GaussClockInjectionFieldTrigger") {
	field(INPA, "$(T)TimInjFieldSyncDelaySP")
	field(INPB, "125")
	field(INPC, "$(T)TimInjFieldEventDelay")
	field(CALC, "(A*B)-C")
	field(FLNK, "$(T)TimInjFieldSyncDelay PP")
	field(EGU, "EvtClkTicks")
}

record(calc, "$(T)TimInjFieldSyncDelay")
{
	field(DESC, "Inj delay in ticks")
	field(EGU, "EvtClkTicks")
	field(INPA, "$(T)GaussClockInjectionFieldTrigger")
	field(CALC, "A")
}

#
# This setpoint is assumed to contain the event delay, which is then
# subtracted below
#
record(longout, $(T)TimExtrFieldSyncDelaySP) {
	field(DESC, "Extraction Field Dly in COIC cycles")
	field(DTYP, "Soft Channel")
	field(FLNK, "$(T)GaussClockExtractionFieldTrigger PP")
	field(EGU, "COIC cycles")
}

record(longout, "$(T)TimExtrFieldEventDelay") {
	field(DESC, "Fine adjustment to Sync Delay")
	field(DTYP, "Soft Channel")
	field(FLNK, "$(T)GaussClockExtractionFieldTrigger PP")
	field(EGU, "EvtClkTicks")
}

record(calc, "$(T)GaussClockExtractionFieldTrigger") {
	field(INPA, "$(T)TimExtrFieldSyncDelaySP")
	field(INPB, "10250")
	field(INPC, "$(T)TimExtrFieldEventDelay")
	field(CALC, "(A*B)-C")
	field(FLNK, "$(T)TimExtrFieldSyncDelay PP")
	field(EGU, "EvtClkTicks")
}

record(calc, "$(T)TimExtrFieldSyncDelay")
{
	field(DESC, "ExtrInj delay in ticks")
	field(EGU, "EvtClkTicks")
	field(INPA, "$(T)GaussClockExtractionFieldTrigger")
	field(CALC, "A")
}

record(ai, "$(T)TimInjFieldCounterFiltd") {
   field(DTYP, "Raw Soft Channel")
   field(INP, "irm:150:CounterValue CPP MS")
   field(SMOO, "0.9")
}

record(ai, "$(T)TimExtrFieldCounterFiltd") {
   field(DTYP, "Raw Soft Channel")
   field(INP, "irm:151:CounterValue CPP MS")
   field(SMOO, "0.9")
}

# Injection Request Waveform: 7 elements meaning:
# 0: SR Bucket Number to target (1 to 328)
# 1: Number of Gun Bunches (1 to 16)
# 2: Injection Mode Number (sets enables for setup, injection, tuning modes)
# 3: Gun Inhibit (0: det. by Inj. Mode Number; 1: Disable the gun trigger)
# 4: Reserved for future use
# 5: Reserved for future use
# 6: Sequence Number (must change from last cycle to do anything but default cycle)
# This is to be used by the timing sequencer.
record(waveform, "$(T)TimInjReq") {
	field(DESC, "Injection Request Waveform")
	field(FTVL, "LONG")
	field(NELM, "7")
}

record(aSub, "$(T)TimInjReq:sub") {
	field(DESC, "Assembles pvs into request wf")
	field(SNAM, "assemble_injreq")
	field(LFLG, "IGNORE")
	field(INPA, "$(T)TimTargetBucket")
	field(INPB, "$(T)TimGunBunchCount")
	field(INPC, "$(T)TimInjMode.RVAL")
	field(INPD, "$(T)TimGunInhibit")
	field(INPE, "$(T)TimSequenceNumber")
	field(FTA, "LONG")
	field(FTB, "LONG")
	field(FTC, "LONG")
	field(FTD, "LONG")
	field(FTE, "LONG")
	field(OUTA, "$(T)TimInjReq PP MS")
	field(FTVA, "LONG")
	field(NOVA, "7")
}

record(bo, "$(T)TimInjReqCommit") {
	field(DESC, "Fill TimInjReq waveform")
	field(FLNK, "$(T)TimInjReq:sub.PROC")
	field(ZNAM, "Off")
	field(ONAM, "On")
	field(HIGH, "1")
}

record(longout, "$(T)TimTargetBucket") {
	field(DESC, "bucket number")
	field(DRVH, "328")
	field(DRVL, "1")
	field(HOPR, "328")
	field(LOPR, "1")
	field(VAL, "1")
	field(PINI, "YES")
}

record(longout, "$(T)TimGunBunchCount") {
	field(DESC, "# gun bunches")
	field(DRVH, "16")
	field(DRVL, "1")
	field(HOPR, "16")
	field(LOPR, "1")
	field(VAL, "1")
	field(PINI, "YES")
}

record(bo, "$(T)TimGunInhibit") {
	field(DESC, "Master Inhibit of Gun Trigger")
	field(ZNAM, "No Inhibit")
	field(ONAM, "Inhibit")
	field(PINI, "YES")
	field(VAL, "0")
}

record(mbbo, "$(T)TimInjMode") {
	field(DESC, "Injection Mode")
	field(OMSL, "supervisory")
	field(ZRST, "Default")
	field(ONST, "Linac Tuning")
	field(TWST, "BR Tuning")
	field(THST, "BTS Tuning")
	field(FRST, "SR Inj Prep")
	field(FVST, "SR Injection")
	field(ZRVL, "0")
	field(ONVL, "10")
	field(TWVL, "20")
	field(THVL, "30")
	field(FRVL, "41")
	field(FVVL, "40")
}

record(longout, "$(T)TimSequenceNumber") {
	field(DESC, "Sequence Number")
}

record(waveform, $(T)GunBunchToGunBias) {
	field(DESC, "Gun Bias Waveform")
	field(EGU, "V")
	field(NELM, "16")
	field(FTVL, "DOUBLE")
}

record(waveform, $(T)GunBunchToInjFieldTrigger) {
	field(DESC, "Injection Field Trigger Waveform")
	field(EGU, "125*EvtClkTicks")
	field(NELM, "16")
	field(FTVL, "DOUBLE")
}

record(subArray, $(T)GunBunchDelay) {
	field(DESC, "Delay due to #Gun Bunches")
	field(EGU, "EvtClkTicks")
	field(INP, "$(T)GunBunchToInjFieldTrigger PP")
	field(DTYP, "Soft Channel")
	field(MALM, "1")
	field(INDX, "0")
}

record(calcout, "$(T)GunBunchIndex") {
	field(INPA, "$(T)TimGunBunchCount PP")
	field(OOPT, "On Change")
	field(CALC, "A-1")
	field(OUT, "$(T)GunBunchDelay.INDX")
}

record(bi, $(T)TimPotentate) {
	field(DESC, "Global timing enable/disable")
	field(VAL, "1")
	field(PINI, "YES")
	field(ZNAM, "Disabled")
	field(ONAM, "Enabled")
}

record(stringin, $(T)TimSeqStatus) {
	field(DESC, "Timing Soft Sequencer Status")
}


# EVR IOC records.
# Injection cycles are initiated only when all are valid.
# FIXME: Should LI11:EVR:[12], CR:EVR1, and S0220:EVR1 also be checked?
record(calc, "$(T)TimAllEVRvalid") {
    field(INPA, "B0215:EVR1:Link-Sts MS CPP")
    field(INPB, "S0123:EVR1:Link-Sts MS CPP")
    field(INPC, "S0817:EVR1:Link-Sts MS CPP")
    field(CALC, "A&B&C")
}
