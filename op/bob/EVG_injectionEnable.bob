<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>EVG injectionEnable</name>
  <x>284</x>
  <y>304</y>
  <width>384</width>
  <height>133</height>
  <background_color>
    <color name="GLOBAL canvas" red="200" green="200" blue="200">
    </color>
  </background_color>
  <grid_visible>false</grid_visible>
  <widget type="label" version="2.0.0">
    <name>Banner</name>
    <text>$(P)$(R) Injector Cycles</text>
    <x>2</x>
    <width>365</width>
    <height>28</height>
    <font>
      <font name="Header 1" family="Liberation Sans" style="BOLD" size="22.0">
      </font>
    </font>
    <foreground_color>
      <color name="black-14" red="0" green="0" blue="0">
      </color>
    </foreground_color>
    <background_color>
      <color name="green-19" red="0" green="128" blue="0">
      </color>
    </background_color>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="group" version="3.0.0">
    <name>Injector Cycles</name>
    <x>21</x>
    <y>36</y>
    <width>346</width>
    <height>80</height>
    <style>2</style>
    <transparent>true</transparent>
    <widget type="label" version="2.0.0">
      <name>Section Title</name>
      <text>Injector Cycle Control</text>
      <width>342</width>
      <height>22</height>
      <font>
        <font name="Header 3" family="Liberation Sans" style="BOLD" size="16.0">
        </font>
      </font>
      <foreground_color>
        <color name="black-14" red="0" green="0" blue="0">
        </color>
      </foreground_color>
      <background_color>
        <color name="green-19" red="0" green="128" blue="0">
        </color>
      </background_color>
      <horizontal_alignment>1</horizontal_alignment>
      <vertical_alignment>1</vertical_alignment>
    </widget>
    <widget type="group" version="3.0.0">
      <name>Injector Cycles Content</name>
      <y>24</y>
      <width>342</width>
      <height>52</height>
      <style>3</style>
      <transparent>true</transparent>
      <widget type="group" version="3.0.0">
        <name>Row</name>
        <width>342</width>
        <height>22</height>
        <style>3</style>
        <transparent>true</transparent>
        <widget type="label" version="2.0.0">
          <name>Label</name>
          <text>Injection Cycles Enabled</text>
          <width>200</width>
          <height>22</height>
          <foreground_color>
            <color name="black-14" red="0" green="0" blue="0">
            </color>
          </foreground_color>
          <background_color>
            <color name="green-19" red="0" green="128" blue="0">
            </color>
          </background_color>
          <horizontal_alignment>2</horizontal_alignment>
          <vertical_alignment>1</vertical_alignment>
        </widget>
        <widget type="byte_monitor" version="2.0.0">
          <name>LED</name>
          <pv_name>$(P)$(R)INJ:injCycleEnabled</pv_name>
          <x>206</x>
          <y>1</y>
          <width>20</width>
          <height>20</height>
          <numBits>1</numBits>
          <horizontal>false</horizontal>
          <square>true</square>
          <off_color>
            <color name="GLOBAL canvas" red="200" green="200" blue="200">
            </color>
          </off_color>
          <on_color>
            <color name="Monitor: NORMAL" red="0" green="255" blue="0">
            </color>
          </on_color>
          <foreground_color>
            <color name="black-14" red="0" green="0" blue="0">
            </color>
          </foreground_color>
        </widget>
      </widget>
      <widget type="group" version="3.0.0">
        <name>Buttons</name>
        <y>27</y>
        <width>342</width>
        <height>25</height>
        <style>3</style>
        <transparent>true</transparent>
        <widget type="action_button" version="3.0.0">
          <name>Write Button</name>
          <actions>
            <action type="write_pv">
              <pv_name>$(pv_name)</pv_name>
              <value>1</value>
              <description>Enable</description>
            </action>
          </actions>
          <pv_name>$(P)$(R)INJ:injCycleEnable</pv_name>
          <text>Enable</text>
          <width>110</width>
          <height>25</height>
          <font>
            <font family="Liberation Sans" style="BOLD" size="14.0">
            </font>
          </font>
          <foreground_color>
            <color name="black-14" red="0" green="0" blue="0">
            </color>
          </foreground_color>
          <background_color>
            <color name="cyan-31" red="0" green="224" blue="224">
            </color>
          </background_color>
        </widget>
        <widget type="action_button" version="3.0.0">
          <name>Write Button</name>
          <actions>
            <action type="write_pv">
              <pv_name>$(pv_name)</pv_name>
              <value>0</value>
              <description>Disable</description>
            </action>
          </actions>
          <pv_name>$(P)$(R)INJ:injCycleEnable</pv_name>
          <text>Disable</text>
          <x>116</x>
          <width>110</width>
          <height>25</height>
          <font>
            <font family="Liberation Sans" style="BOLD" size="14.0">
            </font>
          </font>
          <foreground_color>
            <color name="black-14" red="0" green="0" blue="0">
            </color>
          </foreground_color>
          <background_color>
            <color name="cyan-31" red="0" green="224" blue="224">
            </color>
          </background_color>
        </widget>
        <widget type="action_button" version="3.0.0">
          <name>Write Button</name>
          <actions>
            <action type="write_pv">
              <pv_name>$(pv_name)</pv_name>
              <value>0</value>
              <description>Single Shot</description>
            </action>
          </actions>
          <pv_name>$(P)$(R)INJ:singleShot</pv_name>
          <text>Single Shot</text>
          <x>232</x>
          <width>110</width>
          <height>25</height>
          <font>
            <font family="Liberation Sans" style="BOLD" size="14.0">
            </font>
          </font>
          <foreground_color>
            <color name="black-14" red="0" green="0" blue="0">
            </color>
          </foreground_color>
          <background_color>
            <color name="cyan-31" red="0" green="224" blue="224">
            </color>
          </background_color>
          <rules>
            <rule name="EDM visibility" prop_id="visible" out_exp="false">
              <exp bool_exp="pv0&gt;=0.0 &amp;&amp; pv0&lt;1.0">
                <value>true</value>
              </exp>
              <exp bool_exp="true">
                <value>false</value>
              </exp>
              <pv_name>$(P)$(R)INJ:injCycleEnabled</pv_name>
            </rule>
          </rules>
        </widget>
      </widget>
    </widget>
  </widget>
</display>
