record(longin, "$(P)$(R)INJ:alignStatus_") {
    field(DESC, "Injection alignment status")
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT), 0x0300, 1)")
    field(SCAN, "Passive")
    field(FLNK, "$(P)$(R)INJ:alignStatusFanout_")
}

record(fanout, "$(P)$(R)INJ:alignStatusFanout_") {
    field(DESC, "Injection alignment readback fanout")
    field(LNK0, "$(P)$(R)INJ:alignSelRBVCalc_")
    field(LNK1, "$(P)$(R)INJ:hbSelRBVCalc_")
}

record(calc, "$(P)$(R)INJ:alignSelRBVCalc_") {
    field(DESC, "Injection alignment selection calc")
    field(INPA, "$(P)$(R)INJ:alignStatus_ NPP MS")
    field(INPB, "0xF000")
    field(CALC, "(A&B)>>12")
    field(TSEL, "$(P)$(R)INJ:alignStatus_.TIME")
    field(FLNK, "$(P)$(R)INJ:alignSelRBV")
}

record(calc, "$(P)$(R)INJ:hbSelRBVCalc_") {
    field(DESC, "Injection heartbeat selection calc")
    field(INPA, "$(P)$(R)INJ:alignStatus_ NPP MS")
    field(INPB, "0xF0000")
    field(CALC, "(A&B)>>16")
    field(TSEL, "$(P)$(R)INJ:alignStatus_.TIME")
    field(FLNK, "$(P)$(R)INJ:hbSelRBV")
}

record(mbbi, "$(P)$(R)INJ:alignSelRBV")
{
    field(DESC, "Injection selection readback")
    field(INP,  "$(P)$(R)INJ:alignSelRBVCalc_ NPP")
    field(ZRVL, "0")
    field(ZRST, "Normal")
    field(ONVL, "1")
    field(ONST, "Alternative")
}

record(mbbi, "$(P)$(R)INJ:hbSelRBV")
{
    field(DESC, "Injection heartbeat readback")
