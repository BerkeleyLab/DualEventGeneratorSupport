    field(LOPR, "0")
    field(HOPR, "1")
    field(DRVL, "0")
    field(DRVH, "1")
    field(OUT,  "@asyn($(PORT), 0x1600, 0)")
    field(FLNK, "$(P)$(R)INJ:alignStatus_")
}

record(mbbo, "$(P)$(R)INJ:hbSel") {
    field(DESC, "Injection heartbeat selection")
    field(ZRVL, "0")
    field(ZRST, "Normal")
    field(ONVL, "1")
    field(ONST, "Alternative")
    field(FLNK, "$(P)$(R)INJ:hbSel_")
    info(autosaveFields_pass0, "VAL")
}

record(longout, "$(P)$(R)INJ:hbSel_") {
    field(DESC, "Injection heartbeat selection")
    field(DTYP, "asynInt32")
    field(DOL,  "$(P)$(R)INJ:hbSel NPP")
    field(OMSL, "closed_loop")
    field(LOPR, "0")
    field(HOPR, "1")
    field(DRVL, "0")
    field(DRVH, "1")
    field(OUT,  "@asyn($(PORT), 0x1601, 0)")
    field(FLNK, "$(P)$(R)INJ:alignStatus_")
