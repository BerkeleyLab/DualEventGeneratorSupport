    field(ZRVL, "0")
    field(ZRST, "Normal")
    field(ONVL, "1")
    field(ONST, "Alternative")
}

record(longout, "$(P)$(R)INJ:arBucket") {
    field(DESC, "Injection AR bucket selection")
