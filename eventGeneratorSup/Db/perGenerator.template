record(longin, "$(P)$(R)E$(E):seqStatus") {
    field(DESC, "EVG $(E) sequencer CSR")
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT), 0x010$(I), 1)")
    field(SCAN, "I/O Intr")
    field(TSE,  "-2")
    field(FLNK, "$(P)$(R)E$(E):seqFanout_")
    info(archive, "VeryFastControlled")
}
record(fanout, "$(P)$(R)E$(E):seqFanout_") {
    field(DESC, "EVG $(E) fanout seqStatus")
    field(LNK0, "$(P)$(R)E$(E):seqStarts")
    field(LNK1, "$(P)$(R)E$(E):seq0Enabled")
    field(LNK2, "$(P)$(R)E$(E):seq1Enabled")
    field(LNK3, "$(P)$(R)E$(E):seqSelected")
    field(LNK4, "$(P)$(R)E$(E):seqActive")
    field(LNK5, "$(P)$(R)E$(E):seqBusy")
    field(LNK6, "$(P)$(R)E$(E):seqRequestsAccepted")
    field(LNK7, "$(P)$(R)E$(E):seqRequestsIgnored")
    info(archive, "VeryFastControlled")
}
record(calc, "$(P)$(R)E$(E):seqStarts") {
    field(DESC, "EVG $(E) injection sequences started")
    field(INPA, "$(P)$(R)E$(E):seqStatus NPP MS")
    field(INPB, "0x10")
    field(CALC, "J:=(A&B)#0;VAL+(J&!K);K:=J")
    field(TSEL, "$(P)$(R)E$(E):seqStatus.TIME")
    field(FLNK, "$(P)$(R)E$(E):seqFinishes")
    info(archive, "VeryFastControlled")
}
record(calc, "$(P)$(R)E$(E):seqFinishes") {
    field(DESC, "EVG $(E) injection sequences completed")
    field(INPA, "$(P)$(R)E$(E):seqStatus NPP MS")
    field(INPB, "0x10")
    field(INPC, "$(P)$(R)E$(E):seqStarts NPP MS")
    field(CALC, "J:=(A&B)#0;(!J&K)?C:VAL;K:=J")
    field(TSEL, "$(P)$(R)E$(E):seqStatus.TIME")
    info(archive, "VeryFastControlled")
}
record(calc, "$(P)$(R)E$(E):seq0Enabled") {
    field(DESC, "EVG $(E) sequence 0 enabled")
    field(INPA, "$(P)$(R)E$(E):seqStatus NPP MS")
    field(INPB, "0x01")
    field(CALC, "(A&B)#0")
    field(TSEL, "$(P)$(R)E$(E):seqStatus.TIME")
