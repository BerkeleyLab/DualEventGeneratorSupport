    info(archive, "VeryFastControlled")
}

record(longin, "$(P)$(R)E$(E):EVIOstatus_") { field(FLNK, "$(P)$(R)E$(E):EVIOstatus") }
record(mbbiDirect, "$(P)$(R)E$(E):EVIOstatus") {
    field(DESC, "Bits of $(P)$(R)E$(E):EVIOstatus_")
    field(INP,  "$(P)$(R)E$(E):EVIOstatus_ NPP")
}

record(mbbo, "$(P)$(R)E$(E):diagOut") {
    field(DESC, "EVG $(E) diagnostic output control")
    field(DTYP, "asynUInt32Digital")
    field(OUT,  "@asynMask($(PORT), 0x140$(I), 0xFFFF, 0)")
    field(ZRVL, "0x00")
    field(ZRST, "Static {0, 0}")
    field(ONVL, "0x10")
    field(ONST, "Static {0, 1}")
    field(TWVL, "0x20")
    field(TWST, "Static {1, 0}")
    field(THVL, "0x30")
    field(THST, "Static {1, 1}")
    field(FRVL, "0x100")
    field(FRST, "{RefClk, TxClk}")
    field(FVVL, "0x200")
    field(FVST, "{Heartbeat, TxClk}")
    field(SXVL, "0x300")
    field(SXST, "{Alt Heartbeat, TxClk}")
}
record(longout, "$(P)$(R)E$(E):loopback") {
    field(DESC, "EVG $(E) loopback channel")
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT), 0x150$(I), 0)")
    field(LOPR, "1")
    field(HOPR, "36")
    field(DRVL, "1")
    field(DRVH, "36")
    field(FLNK, "$(P)$(R)E$(E):latencyRb_")
}
record(seq, "$(P)$(R)E$(E):latencyRb_") {
    field(DESC, "Force EVG $(E) latency readback")
    field(LNK1, "$(P)$(R)E$(E):latency.PROC")
    field(DOL1, "1")
    field(DLY1, "0.01")  # Provide time for measurement to stabilize
}
record(ai, "$(P)$(R)E$(E):latency") {
    field(DESC, "EVG $(E) round-trip latency")
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT), 0x020$(I), 0)")
    field(SCAN, "10 second")
    field(EGU,  "ns")
    field(LINR, "SLOPE")
    field(ESLO, "0.5")
    field(EOFF, "0")
    field(LOPR, "0")
    field(HOPR, "1000")
    field(LOLO, "0.25")
    field(LLSV, "MAJOR")
}
record(fanout, "$(P)$(R)E$(E):diagOut:rc_") {
    field(DESC, "Push EVG $(E) diag out on (re)connect)")
    field(SCAN, "Event")
    field(EVNT, "RECON")
    field(LNK1, "$(P)$(R)E$(E):diagOut")
    field(LNK2, "$(P)$(R)E$(E):loopback")
}
